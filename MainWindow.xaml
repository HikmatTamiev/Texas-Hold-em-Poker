<Window x:Class="TexasHoldem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Texas Hold'em" Height="820" Width="1100"
        MinHeight="760" MinWidth="980"
        FontFamily="Segoe UI"
        Background="#0B3D24">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face"
                                Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35" Color="Black"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Face" Property="Opacity" Value="0.32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Image Source="pack://application:,,,/Images/table_background.jpg"
               Stretch="UniformToFill"
               StretchDirection="Both"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="TEXAS HOLD'EM"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#F3D38A"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.7" Color="Black"/>
                </TextBlock.Effect>
            </TextBlock>

            <Grid Grid.Row="1">
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,20,20"
                        Background="#CC102E1A"
                        CornerRadius="14"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="DECK" FontSize="12" FontWeight="Bold" Foreground="#F3D38A" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <Canvas x:Name="DeckCanvas" Width="96" Height="136" ClipToBounds="True"/>
                        <TextBlock x:Name="DeckCountText" Text="52" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Width="720" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="140,0,40,0">
                    <Border Background="#B31A120C" CornerRadius="16" Padding="16,10" HorizontalAlignment="Center">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="OPPONENT" FontSize="13" FontWeight="Bold" Foreground="#C8B48A" VerticalAlignment="Center"/>
                                <Border Background="#F3D38A" CornerRadius="8" Padding="8,2" Margin="10,0,0,0">
                                    <TextBlock x:Name="OppBlindText" Text="BB" FontSize="12" FontWeight="Bold" Foreground="#1A120C"/>
                                </Border>
                                <TextBlock x:Name="OppChipsText" Text="1000" FontSize="16" FontWeight="Bold" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <StackPanel x:Name="OppChipStack" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                            <StackPanel x:Name="OpponentPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel HorizontalAlignment="Center" Margin="0,16,0,16">
                        <Border Background="#B3102E1A" CornerRadius="18" Padding="16,6" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="POT" FontSize="12" FontWeight="Bold" Foreground="#F3D38A" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PotAmountText" Text="30" FontSize="20" FontWeight="Bold" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <StackPanel x:Name="PotChipStack" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="BoardPanel" Orientation="Horizontal" HorizontalAlignment="Center" MinHeight="134"/>
                    </StackPanel>

                    <Border Background="#B31A120C" CornerRadius="16" Padding="16,10" HorizontalAlignment="Center">
                        <StackPanel>
                            <StackPanel x:Name="HolePanel" Orientation="Horizontal" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <TextBlock Text="YOU" FontSize="13" FontWeight="Bold" Foreground="#C8B48A" VerticalAlignment="Center"/>
                                <Border Background="#F3D38A" CornerRadius="8" Padding="8,2" Margin="10,0,0,0">
                                    <TextBlock x:Name="YouBlindText" Text="SB" FontSize="12" FontWeight="Bold" Foreground="#1A120C"/>
                                </Border>
                                <TextBlock x:Name="YouChipsText" Text="1000" FontSize="16" FontWeight="Bold" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <StackPanel x:Name="YouChipStack" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="FoldButton" Content="Fold" Style="{StaticResource ActionButton}" Background="#8C2F2F" Click="Fold_Click"/>
                    <Button x:Name="CheckButton" Content="Check" Style="{StaticResource ActionButton}" Background="#2C6B5A" Click="Check_Click"/>
                    <Button x:Name="CallButton" Content="Call" Style="{StaticResource ActionButton}" Background="#1E7A45" Click="Call_Click"/>
                    <StackPanel Orientation="Horizontal" Margin="5,0">
                        <Button x:Name="RaiseButton" Content="Raise 20" Style="{StaticResource ActionButton}" Background="#C47B12" Margin="0" Click="Raise_Click"/>
                        <Button x:Name="RaiseMenuButton" Content="▾" Style="{StaticResource ActionButton}" Background="#9A5F0E" Padding="10,10" Margin="3,0,0,0" Click="RaiseMenu_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5,0">
                        <Button x:Name="BetButton" Content="Bet 20" Style="{StaticResource ActionButton}" Background="#A67C2D" Margin="0" Click="Bet_Click"/>
                        <Button x:Name="BetMenuButton" Content="▾" Style="{StaticResource ActionButton}" Background="#7E5C1F" Padding="10,10" Margin="3,0,0,0" Click="BetMenu_Click"/>
                    </StackPanel>
                    <Button x:Name="AllInButton" Content="All in" Style="{StaticResource ActionButton}" Background="#7A1F3D" Click="AllIn_Click"/>
                    <Button x:Name="DealNextButton" Content="Deal next" Style="{StaticResource ActionButton}" Background="#1E4F86" Click="DealNext_Click"/>
                    <Button x:Name="NewHandButton" Content="New hand" Style="{StaticResource ActionButton}" Background="#3E4550" Click="NewHand_Click"/>
                    <Button x:Name="ResetStacksButton" Content="Reset stacks" Style="{StaticResource ActionButton}" Background="#4A3B32" Click="ResetStacks_Click"/>
                </StackPanel>

                <Border x:Name="RaiseSliderPanel"
                        Visibility="Collapsed"
                        Background="#1A120C"
                        CornerRadius="16"
                        Padding="18,12"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Custom raise" Foreground="#C8B48A" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock x:Name="RaiseAmountText" Text="+20" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Width="64"/>
                        <Slider x:Name="RaiseSlider"
                                Width="220"
                                Minimum="20"
                                Maximum="100"
                                Value="20"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                Margin="8,0"
                                ValueChanged="RaiseSlider_ValueChanged"/>
                        <Button Content="Confirm" Style="{StaticResource ActionButton}" Background="#C47B12" Click="ConfirmCustomRaise_Click"/>
                    </StackPanel>
                </Border>

                <Border x:Name="BetSliderPanel"
                        Visibility="Collapsed"
                        Background="#1A120C"
                        CornerRadius="16"
                        Padding="18,12"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Custom bet" Foreground="#C8B48A" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock x:Name="BetAmountText" Text="20" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Width="64"/>
                        <Slider x:Name="BetSlider"
                                Width="220"
                                Minimum="20"
                                Maximum="100"
                                Value="20"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                Margin="8,0"
                                ValueChanged="BetSlider_ValueChanged"/>
                        <Button Content="Confirm" Style="{StaticResource ActionButton}" Background="#A67C2D" Click="ConfirmCustomBet_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock x:Name="HandNameText"
                       Grid.Row="3"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="White"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="980"
                       HorizontalAlignment="Center"
                       Margin="0,14,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.75" Color="Black"/>
                </TextBlock.Effect>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
