<Window x:Class="TexasHoldem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Texas Hold'em" Height="860" Width="1100"
        MinHeight="800" MinWidth="980"
        FontFamily="pack://application:,,,/Fonts/#Cinzel"
        Background="#0B3D24">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFF8E7"/>
            <Setter Property="FontFamily" Value="pack://application:,,,/Fonts/#Cinzel"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Rim"
                                Background="#D4AF37"
                                CornerRadius="8"
                                Padding="1.5"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.45" Color="Black"/>
                            </Border.Effect>
                            <Border x:Name="Face"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Opacity" Value="0.9"/>
                                <Setter TargetName="Rim" Property="Background" Value="#F3D38A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Rim" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SeatLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="pack://application:,,,/Fonts/#Cinzel"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#E8D5A3"/>
        </Style>

        <Style x:Key="ChipAmount" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="pack://application:,,,/Fonts/#Cinzel"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFF4C2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Image Source="pack://application:,,,/Images/table_background.jpg"
               Stretch="UniformToFill"
               StretchDirection="Both"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"
               SnapsToDevicePixels="True"/>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="TEXAS HOLD'EM"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="#F3D38A"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,10">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.75" Color="Black"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- Scales down if needed so cards never cover the button row. -->
            <Viewbox Grid.Row="1"
                     Stretch="Uniform"
                     StretchDirection="DownOnly"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Margin="0,0,0,8">
                <Grid Width="920" Height="500" ClipToBounds="False">
                    <!-- Cards stay at the true center, same as the title. -->
                    <StackPanel Width="640" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Background="#C218100A"
                                BorderBrush="#66D4AF37"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16,10"
                                HorizontalAlignment="Center">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="OPPONENT" Style="{StaticResource SeatLabel}" VerticalAlignment="Center"/>
                                    <Border Background="#F3D38A" CornerRadius="4" Padding="8,2" Margin="12,0,0,0">
                                        <TextBlock x:Name="OppBlindText" Text="BB" FontSize="11" FontWeight="Bold" Foreground="#1A120C"/>
                                    </Border>
                                    <TextBlock Text="  ·  " Foreground="#8A7A55" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="OppChipsText" Text="1,000" Style="{StaticResource ChipAmount}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel x:Name="OpponentPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel HorizontalAlignment="Center" Margin="0,14,0,14">
                            <Border Background="#C2102E1A"
                                    BorderBrush="#66D4AF37"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16,6"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="POT" Style="{StaticResource SeatLabel}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PotAmountText" Text="30" Style="{StaticResource ChipAmount}" FontSize="22" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="BoardPanel" Orientation="Horizontal" HorizontalAlignment="Center" MinHeight="120"/>
                        </StackPanel>

                        <Border Background="#C218100A"
                                BorderBrush="#66D4AF37"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16,10"
                                HorizontalAlignment="Center">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock Text="YOU" Style="{StaticResource SeatLabel}" VerticalAlignment="Center"/>
                                    <Border Background="#F3D38A" CornerRadius="4" Padding="8,2" Margin="12,0,0,0">
                                        <TextBlock x:Name="YouBlindText" Text="SB" FontSize="11" FontWeight="Bold" Foreground="#1A120C"/>
                                    </Border>
                                    <TextBlock Text="  ·  " Foreground="#8A7A55" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="YouChipsText" Text="1,000" Style="{StaticResource ChipAmount}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel x:Name="HolePanel" Orientation="Horizontal" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Deck is shifted right without moving the centered cards. -->
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#C2102E1A"
                            BorderBrush="#66D4AF37"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,10">
                        <Border.RenderTransform>
                            <TranslateTransform X="390"/>
                        </Border.RenderTransform>
                        <StackPanel>
                            <TextBlock Text="DECK" Style="{StaticResource SeatLabel}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <Canvas x:Name="DeckCanvas" Width="96" Height="136" ClipToBounds="True"/>
                            <TextBlock x:Name="DeckCountText" Text="52" Style="{StaticResource ChipAmount}" FontSize="15" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Viewbox>

            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,4,0,0" Panel.ZIndex="5">
                <Border Background="#9918100A"
                        BorderBrush="#55D4AF37"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="10,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="FoldButton" Content="FOLD" Style="{StaticResource ActionButton}" Background="#7A2424" Click="Fold_Click"/>
                        <Button x:Name="CheckButton" Content="CHECK" Style="{StaticResource ActionButton}" Background="#1F5C4D" Click="Check_Click"/>
                        <Button x:Name="CallButton" Content="CALL" Style="{StaticResource ActionButton}" Background="#176B3A" Click="Call_Click"/>
                        <StackPanel Orientation="Horizontal" Margin="4,0">
                            <Button x:Name="RaiseButton" Content="RAISE 20" Style="{StaticResource ActionButton}" Background="#A66A10" Margin="0" Click="Raise_Click"/>
                            <Button x:Name="RaiseMenuButton" Content="▾" Style="{StaticResource ActionButton}" Background="#7A4E0C" Padding="10,11" Margin="3,0,0,0" Click="RaiseMenu_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="4,0">
                            <Button x:Name="BetButton" Content="BET 20" Style="{StaticResource ActionButton}" Background="#8B6824" Margin="0" Click="Bet_Click"/>
                            <Button x:Name="BetMenuButton" Content="▾" Style="{StaticResource ActionButton}" Background="#6A4E1A" Padding="10,11" Margin="3,0,0,0" Click="BetMenu_Click"/>
                        </StackPanel>
                        <Button x:Name="AllInButton" Content="ALL IN" Style="{StaticResource ActionButton}" Background="#6B1833" Click="AllIn_Click"/>
                        <Button x:Name="DealNextButton" Content="DEAL" Style="{StaticResource ActionButton}" Background="#1A4575" Click="DealNext_Click"/>
                        <Button x:Name="NewHandButton" Content="NEW HAND" Style="{StaticResource ActionButton}" Background="#2F3540" Click="NewHand_Click"/>
                        <Button x:Name="ResetStacksButton" Content="RESET" Style="{StaticResource ActionButton}" Background="#3D322A" Click="ResetStacks_Click"/>
                    </StackPanel>
                </Border>

                <Border x:Name="RaiseSliderPanel"
                        Visibility="Collapsed"
                        Background="#E118100A"
                        BorderBrush="#66D4AF37"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18,12"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="CUSTOM RAISE" Style="{StaticResource SeatLabel}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock x:Name="RaiseAmountText" Text="+20" Style="{StaticResource ChipAmount}" VerticalAlignment="Center" Width="64"/>
                        <Slider x:Name="RaiseSlider"
                                Width="220"
                                Minimum="20"
                                Maximum="100"
                                Value="20"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                Margin="8,0"
                                ValueChanged="RaiseSlider_ValueChanged"/>
                        <Button Content="CONFIRM" Style="{StaticResource ActionButton}" Background="#A66A10" Click="ConfirmCustomRaise_Click"/>
                    </StackPanel>
                </Border>

                <Border x:Name="BetSliderPanel"
                        Visibility="Collapsed"
                        Background="#E118100A"
                        BorderBrush="#66D4AF37"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18,12"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="CUSTOM BET" Style="{StaticResource SeatLabel}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock x:Name="BetAmountText" Text="20" Style="{StaticResource ChipAmount}" VerticalAlignment="Center" Width="64"/>
                        <Slider x:Name="BetSlider"
                                Width="220"
                                Minimum="20"
                                Maximum="100"
                                Value="20"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                Margin="8,0"
                                ValueChanged="BetSlider_ValueChanged"/>
                        <Button Content="CONFIRM" Style="{StaticResource ActionButton}" Background="#8B6824" Click="ConfirmCustomBet_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock x:Name="HandNameText"
                       Grid.Row="3"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#FFF4C2"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="980"
                       HorizontalAlignment="Center"
                       Margin="0,14,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.8" Color="Black"/>
                </TextBlock.Effect>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
