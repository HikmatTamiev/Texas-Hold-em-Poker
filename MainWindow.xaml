<Window x:Class="TexasHoldem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TexasHoldem"
        mc:Ignorable="d"
        Title="Texas Hold'em" Height="980" Width="800"
        Background="#146C36">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Texas Hold'em"
                       FontSize="40"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>
            <TextBlock x:Name="ChipText"
                       FontSize="20"
                       Foreground="White"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>
            <TextBlock Text="The board"
                       FontSize="22"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0"/>
            <StackPanel x:Name="BoardPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"/>
            <TextBlock Text="Your cards"
                       FontSize="22"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
            <StackPanel x:Name="HolePanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <Button Content="Check" Margin="6" Padding="14,6" Click="Check_Click"/>
                <Button Content="Bet 20" Margin="6" Padding="14,6" Click="Bet_Click"/>
                <Button Content="Deal next" Margin="6" Padding="14,6" Click="DealNext_Click"/>
            </StackPanel>
            <TextBlock Text="Opponent"
                       FontSize="22"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,16,0,0"/>
            <StackPanel x:Name="OpponentPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"/>
            <TextBlock x:Name="HandNameText"
                       FontSize="28"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</Window>
