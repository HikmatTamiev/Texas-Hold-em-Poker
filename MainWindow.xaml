<Window x:Class="TexasHoldem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TexasHoldem"
        mc:Ignorable="d"
        Title="Texas Hold'em" Height="680" Width="860"
        Background="#146C36">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Texas Hold'em"
                       FontSize="32"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>
            <TextBlock x:Name="ChipText"
                       FontSize="18"
                       Foreground="White"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>
            <TextBlock Text="The board"
                       FontSize="18"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
            <StackPanel x:Name="BoardPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <StackPanel Width="240" Margin="0,0,36,0">
                    <TextBlock Text="Your cards"
                               FontSize="18"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <StackPanel x:Name="HolePanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Width="240" Margin="36,0,0,0">
                    <TextBlock Text="Opponent"
                               FontSize="18"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <StackPanel x:Name="OpponentPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <Button x:Name="FoldButton" Content="Fold" Margin="6" Padding="14,6" Click="Fold_Click"/>
                <Button x:Name="CheckButton" Content="Check" Margin="6" Padding="14,6" Click="Check_Click"/>
                <Button x:Name="CallButton" Content="Call" Margin="6" Padding="14,6" Click="Call_Click"/>
                <Button x:Name="RaiseButton" Content="Raise 20" Margin="6" Padding="14,6" Click="Raise_Click"/>
                <Button x:Name="BetButton" Content="Bet 20" Margin="6" Padding="14,6" Click="Bet_Click"/>
                <Button x:Name="DealNextButton" Content="Deal next" Margin="6" Padding="14,6" Click="DealNext_Click"/>
                <Button x:Name="NewHandButton" Content="New hand" Margin="6" Padding="14,6" Click="NewHand_Click"/>
            </StackPanel>
            <TextBlock x:Name="HandNameText"
                       FontSize="22"
                       Foreground="White"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="760"
                       HorizontalAlignment="Center"
                       Margin="0,14,0,0"/>
        </StackPanel>
    </Grid>
</Window>
